import time

score = 0
completed = []  # lesson numbers the student has finished

BADGES = {
    "1": "Hello World Hero",
    "2": "Syntax Sage",
    "3": "Math Wizard",
    "4": "Input Ninja",
    "5": "Decision Maker",
    "6": "Logic Master",
    "7": "Loop Legend",
}


# COUNTDOWN FUNCTION
def countdown():
    print("\nGet ready! Your lesson will start in...")

    for number in range(5, 0, -1):
        print(number)
        time.sleep(1)

    print("LET'S START!")


# HELPER: asks for a whole number and keeps asking until it gets one
def ask_number(prompt):
    while True:
        text = input(prompt)
        try:
            return int(text)
        except ValueError:
            print("Please type a whole number.")


# HELPER: gives points and a badge the FIRST time a lesson is finished
def finish_lesson(lesson):
    global score
    if lesson not in completed:
        completed.append(lesson)
        score += 10
        print("\nLesson complete! You earned 10 points!")
        print("NEW BADGE UNLOCKED:", BADGES[lesson])
    else:
        print("\nLesson reviewed again. (Points are only given the first time.)")


# WELCOME SCREEN
print("======================================")
print("          PYTHON LEARNING ADVENTURE")
print("======================================")

name = input("Enter your name: ")

print("\nWelcome,", name + "!")
print("Are you ready to learn Python?")

input("\nPress ENTER to start...")


